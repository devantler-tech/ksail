
[TestGenHelmReleaseWithHealthCheckExprs - 1]
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: sealed-secrets
  namespace: default
spec:
  chartRef:
    kind: OCIRepository
    name: sealed-secrets-chart
    namespace: default
  healthCheckExprs:
  - apiVersion: bitnami.com/v1alpha1
    current: status.conditions.filter(e, e.type == 'Synced').all(e, e.status == 'True')
    failed: status.conditions.filter(e, e.type == 'Synced').all(e, e.status == 'False')
    kind: SealedSecret
  - apiVersion: fluxcd.controlplane.io/v1
    current: status.conditions.filter(e, e.type == 'Ready').all(e, e.status == 'True')
  - apiVersion: v1
    current: data.ready == 'true'
    inProgress: '!has(data.ready)'
    kind: ConfigMap
  interval: 1m0s
  timeout: 5m0s
status: {}

---
