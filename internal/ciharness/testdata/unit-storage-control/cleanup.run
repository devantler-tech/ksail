set -euo pipefail
cleanup_disk() {
  # Zero preserves unconditional reclamation for every existing consumer.
  if [[ ! "$MINIMUM_FREE_DISK_GIB" =~ ^(0|[1-9][0-9]{0,3})$ ]] || ((MINIMUM_FREE_DISK_GIB > 1024)); then
    echo '::error::minimum-free-disk-gib must be a whole number from 0 through 1024'
    exit 2
  fi
  read_capacity() {
    local frame fields total used available timeout_command=timeout
    # Ubuntu 26 supplies GNU timeout under this explicit name.
    if command -v gnutimeout >/dev/null 2>&1; then timeout_command=gnutimeout; fi
    if ! frame="$("$timeout_command" --kill-after=1s 5s env LC_ALL=C df -Pk / 2>/dev/null)" ||
       ! fields="$(awk 'NR == 2 {print $2, $3, $4} END {if (NR != 2) exit 1}' <<< "$frame")" ||
       [[ ! "$fields" =~ ^([0-9]{1,12})[[:space:]]([0-9]{1,12})[[:space:]]([0-9]{1,12})$ ]]; then
      return 1
    fi
    total=$((10#${BASH_REMATCH[1]})); used=$((10#${BASH_REMATCH[2]})); available=$((10#${BASH_REMATCH[3]}))
    ((total > 0 && used <= total && available <= total && used + available <= total)) || return 1
    printf '%s\n' "$available"
  }
  before=null; after=null; status=measured; decision=reclaim
  before="$(read_capacity)" || { before=null; status=unknown; }
  if [[ "$before" != null ]] && ((MINIMUM_FREE_DISK_GIB > 0 && before >= MINIMUM_FREE_DISK_GIB * 1048576)); then
    # An opted-in caller supplied a budget, and a complete observation meets it.
    decision=retain
    after="$before"
  else
    # Unknown capacity retains the existing production protection.
    sudo rm -rf \
      /usr/local/lib/android \
      /usr/share/dotnet \
      /opt/ghc \
      /usr/local/share/boost \
      /usr/share/swift \
      /opt/hostedtoolcache/CodeQL \
      /opt/hostedtoolcache/PyPy \
      /usr/local/share/powershell \
      /usr/share/miniconda || true
    after="$(read_capacity)" || { after=null; status=unknown; }
  fi
  record="$(printf '{"status":"%s","decision":"%s","minimum_free_gib":%s,"before_available_kib":%s,"after_available_kib":%s}' \
    "$status" "$decision" "$MINIMUM_FREE_DISK_GIB" "$before" "$after")"
  printf 'GO_DISK_CLEANUP %s\n' "$record"
  if [[ -n "${GO_DISK_CLEANUP_RECEIPT_FILE:-}" ]]; then
    if ! (umask 077; printf '%s\n' "$record" > "$GO_DISK_CLEANUP_RECEIPT_FILE"); then
      echo '::warning::Go cleanup receipt could not be retained; native collection is incomplete' >&2
    fi
  fi
}
if [[ "$MEASURE_DISK_USAGE" == true ]]; then
  export -f cleanup_disk
  bash "$RUNNER_TEMP/measure-go-disk.sh" "$GO_DISK_CLEANUP_PHASE" bash -euo pipefail -c cleanup_disk
else
  cleanup_disk
fi
