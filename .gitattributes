go.mod text eol=lf
go.sum text eol=lf

# Source integrity hashes the published bytes on every checkout platform.
third_party/cel-go/** text=auto eol=lf
third_party/glamour/** text=auto eol=lf
third_party/go-macholibre/** text=auto eol=lf
third_party/kyverno-jmespath/** -filter -text
third_party/jmespath/** -filter -text
third_party/ansi/** -filter -text
third_party/redisotel/** -filter -text
third_party/rediscmd/** -filter -text
